# FaceTrace Configuration
# Copy this file to .env and fill in your values

# ===========================================
# BLOCKCHAIN MODE SELECTION
# ===========================================
# Options:
#   "hardhat" - Local Hardhat node (default, no MetaMask needed)
#   "polygon" - Polygon Amoy public testnet (requires MetaMask + test MATIC)
BLOCKCHAIN_MODE=hardhat

# ===========================================
# HARDHAT MODE (LOCAL DEVELOPMENT)
# ===========================================
# Local RPC endpoint
RPC_URL=http://127.0.0.1:8545

# Hardhat prefunded development account
# Only used in hardhat mode - NEVER use on real networks
# This is Hardhat's account #0 (10000 ETH)
HARDHAT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract address (from blockchain/scripts/deploy.js)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ===========================================
# POLYGON AMOY MODE (PUBLIC TESTNET)
# ===========================================
# Only used when BLOCKCHAIN_MODE=polygon
# 1. Install MetaMask: https://metamask.io
# 2. Add Polygon Amoy testnet (Chain ID: 80002)
# 3. Get test MATIC: https://faucet.polygon.technology/
# 4. Export your private key from MetaMask
# 5. Deploy VerificationRegistry via Remix or Hardhat
#
# RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# PRIVATE_KEY=your_polygon_wallet_private_key
# CONTRACT_ADDRESS=your_deployed_contract_address

# ===========================================
# REVERSE IMAGE SEARCH (REQUIRED for real search)
# ===========================================
# At least one provider is REQUIRED for genuine reverse search.
# The pipeline performs REAL API calls at runtime.

# SerpAPI (RECOMMENDED) - Google Lens reverse image search
# Get free key: https://serpapi.com/ (100 free searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Bing Visual Search API (Microsoft Azure) - Alternative
# Get key: https://portal.azure.com (Cognitive Services)
# BING_VISUAL_SEARCH_KEY=your_bing_key_here

# TinEye API - Alternative
# Get key: https://api.tineye.com/
# TINEYE_API_KEY=your_tineye_api_key_here

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Face similarity threshold (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.75

# Maximum number of candidates to verify
MAX_CANDIDATES=5

# Supported social media platforms
SOCIAL_PLATFORMS=instagram,twitter,x,facebook,tiktok,youtube

# ===========================================
# NETWORK SETTINGS
# ===========================================

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum retries for failed requests
MAX_RETRIES=3
